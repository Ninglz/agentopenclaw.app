{
  "name": "agentopenclaw-app",
  "main": "./cloudflare/worker.mjs",
  "compatibility_date": "2026-06-02",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "agentopenclaw.app/*", "zone_name": "agentopenclaw.app" }],
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/waitlist"]
  },
  "send_email": [
    { "name": "WAITLIST_EMAIL", "destination_address": "ninglz2073@gmail.com" }
  ],
  "ratelimits": [
    { "name": "WAITLIST_PER_IP", "namespace_id": "761201", "simple": { "limit": 4, "period": 60 } },
    { "name": "WAITLIST_TOTAL", "namespace_id": "761202", "simple": { "limit": 40, "period": 60 } }
  ]
}
